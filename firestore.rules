// Public spectators may read the single live race snapshot.
// Every browser write is denied. The raceAdmin Cloud Function verifies the
// event PIN and uses the Admin SDK to perform validated, revision-checked writes.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /raceSnapshots/{snapshotId} {
      allow read: if snapshotId == 'main';
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
